{
  "manifest_version": 3,
  "name": "GOAL in Browser",
  "short_name": "GOAL in Browser",
  "version": "0.2.0",
  "description": "Privacy protection: blocks ads, trackers and fingerprinting scripts, and sets privacy options. Local settings only.",
  "minimum_chrome_version": "128",
  "permissions": ["activeTab", "browsingData", "contentSettings", "declarativeNetRequest", "privacy", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" },
      { "id": "fingerprinting", "enabled": true, "path": "rules/fingerprinting.json" }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GOAL in Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

# tools/inkbrowser/gn/release.gn
#
# GN arguments for an InkBrowser Windows x64 release build. Copy this file to
# out\Default\args.gn, then run `gn gen out\Default --fail-on-unused-args`.
# Every name below is an argument that the sources define, so a misspelled or
# removed argument fails the generation step instead of being ignored.
#
# Provenance (checked 2026-10-08; see docs/inkbrowser/BLUEPRINT.md section 13):
#   [U] ungoogled-chromium flags.gn @ 3e46b13 (base 154.0.8037.97), BSD-3-Clause.
#   [W] ungoogled-chromium-windows flags.windows.gn @ f03c33d, BSD-3-Clause.
#   [C] Chromium main, build/config/chrome_build.gni: is_chrome_branded default false.
#   [F] Chromium main, chrome/browser/chrome_for_testing/args.gni: ffmpeg_branding = "Chrome".
#
# Not set here on purpose:
#   branding_path_component: the default ("chromium") is kept, and InkBrowser edits
#     chrome/app/theme/chromium/BRANDING in place.
#   chrome_pgo_phase: 0 for the first builds. Official PGO builds need profile
#     downloads; enable them only after a working build exists.

# --- Build type and target ---------------------------------------------------
is_official_build = true                  # [W]
is_debug = false                          # [W]
target_cpu = "x64"                        # [W]
is_clang = true                           # [W]
is_component_build = false                # [W]
use_sysroot = false                       # [W]
enable_rust = true                        # [W]
enable_swiftshader = false                # [W]
dcheck_always_on = false                  # [W]
symbol_level = 0                          # [W]
blink_symbol_level = 0                    # [W]
v8_symbol_level = 0                       # [W]
treat_warnings_as_errors = false          # [U]
exclude_unwind_tables = true              # [U]
clang_use_chrome_plugins = false          # [U]
disable_fieldtrial_testing_config = true  # [U]
use_unofficial_version_number = false     # [U]
chrome_pgo_phase = 0                      # [U] (see the note above)
v8_drumbrake_bounds_checks = true         # [U]

# --- Branding ------------------------------------------------------------------
is_chrome_branded = false                 # [C] keeps the Chromium-side branding path

# --- Media -----------------------------------------------------------------------
proprietary_codecs = true                 # [W]
ffmpeg_branding = "Chrome"                # [W][F] codec-set selector, not a UI string
enable_mse_mpeg2ts_stream_parser = true   # [W]
enable_widevine = false                   # [U] off: InkBrowser ships no WidevineCdm (layout-manifest.json
                                         #     excludedComponents). Streaming DRM will not play; see BLUEPRINT section 2.

# --- Google services and telemetry: off by default ------------------------------
google_api_key = ""                       # [U]
google_default_client_id = ""             # [U]
google_default_client_secret = ""         # [U]
use_official_google_api_keys = false      # [U]
safe_browsing_mode = 0                    # [U] a trade-off, see BLUEPRINT section 2
enable_reporting = false                  # [U]
enable_remoting = false                   # [U]
enable_mdns = false                       # [U]
enable_service_discovery = false          # [U]
enable_hangout_services_extension = false # [U]

{
  "schemaVersion": 1,
  "product": "InkBrowser",
  "launcher": "inkbrowser-chrome.exe",
  "installed": {
    "description": "Two-level layout of image-1: the launcher is in Application\\, and the runtime is in a versioned folder Application\\<Chromium version>\\.",
    "launcherDir": "Application",
    "versionDirPattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$",
    "launcherDirOptional": [
      "chrome_proxy.exe",
      "chrome.VisualElementsManifest.xml",
      "inkbrowser.VisualElementsManifest.xml"
    ]
  },
  "runtime": {
    "description": "Files the browser cannot start without. Taken from the entries of chrome/tools/build/win/FILES.cfg that have no architecture filter (Chromium main, checked 2026-10-08).",
    "required": [
      "chrome.dll",
      "chrome_elf.dll",
      "chrome_child.dll",
      "resources.pak",
      "chrome_100_percent.pak",
      "chrome_200_percent.pak",
      "icudtl.dat",
      "v8_context_snapshot.bin",
      "locales/en-US.pak"
    ],
    "optional": [
      "chrome_renderer.dll",
      "chrome_wer.dll",
      "eventlog_provider.dll",
      "D3DCompiler_47.dll",
      "libEGL.dll",
      "libGLESv2.dll",
      "vulkan-1.dll",
      "dxcompiler.dll",
      "vk_swiftshader.dll",
      "vk_swiftshader_icd.json",
      "notification_helper.exe",
      "chrome_pwa_launcher.exe",
      "IwaKeyDistribution"
    ]
  },
  "flat": {
    "description": "Portable alternative (section 5 of the request): the launcher and the runtime sit in one folder, with no version folder."
  },
  "forbiddenFiles": [
    "electron.exe",
    "node.dll",
    "package.json",
    "package-lock.json"
  ],
  "forbiddenPatterns": [
    "*.asar"
  ],
  "forbiddenDirectories": [
    "node_modules"
  ],
  "upstreamLauncherNames": [
    "chrome.exe"
  ],
  "googleServiceBinaries": [
    "gaia1_0.dll",
    "gcapi_dll.dll",
    "gcp_setup.exe",
    "gcp_installer.exe",
    "remoting_core.dll",
    "remoting_desktop.exe",
    "remoting_host.exe",
    "remoting_native_messaging_host.exe",
    "remoting_start_host.exe",
    "remote_assistance_host.exe",
    "remote_assistance_host_uiaccess.exe",
    "remote_security_key.exe"
  ],
  "excludedComponentsDescription": "Google-specific components of the Chrome installer. InkBrowser ships none of them: stage.mjs leaves them out, and a tree that contains one is invalid. Their feature switches are off in gn/release.gn.",
  "excludedComponents": [
    "WidevineCdm",
    "MEIPreload",
    "PrivacySandboxAttestationsPreloaded"
  ]
}
